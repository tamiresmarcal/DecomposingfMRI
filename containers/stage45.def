Bootstrap: docker
From: rocker/r-ver:4.4.1

# Stage 4/5 image: state sets, transitions, and the crossed variance
# decomposition. SEPARATE FROM fmri_decomp.sif on purpose -- that one runs
# stages 2 and 3 and has been stable for months, and adding Stan to it would
# mean rebuilding the image every cohort re-run depends on.
#
# BUILD (login node -- needs network; compute nodes have none):
#
#   cd /project/6008063/tamires/DecomposingfMRI
#   module load apptainer
#   apptainer build --fakeroot \
#       /project/6008063/tamires/singularity/fmri_decomp_stage45.sif \
#       containers/stage45.def
#
# Expect 20-40 minutes and ~6 GB. Most of it is Stan. If --fakeroot is refused
# on this cluster, build on a machine where you have root and copy the .sif.
#
# WHY rocker/r-ver AND NOT A PLAIN UBUNTU: it ships with Posit Package Manager
# configured, so install.packages() pulls prebuilt Linux binaries instead of
# compiling from source. brms + its dependency tree is the difference between
# minutes and hours.

%labels
    Purpose    DecomposingfMRI stage 4/5 -- state sets, transitions, brms
    R          4.4.1
    Python     3.11

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-dev python3.11-venv python3-pip \
        build-essential gfortran git curl ca-certificates \
        libcurl4-openssl-dev libssl-dev libxml2-dev libfontconfig1-dev \
        libharfbuzz-dev libfribidi-dev libfreetype6-dev libpng-dev \
        libtiff5-dev libjpeg-dev
    rm -rf /var/lib/apt/lists/*

    # ---- Python. A venv at a fixed path so PYTHONPATH leaking in from the
    # host cannot shadow it -- see --cleanenv in the sbatch scripts.
    python3.11 -m venv /opt/venv
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip wheel

    # Pinned: an unpinned image is not a reproducible one, and numpy 2 vs 1
    # ABI mismatches are exactly what bit the ad-hoc /tmp install.
    /opt/venv/bin/pip install --no-cache-dir \
        "numpy==2.1.3" \
        "scipy==1.14.1" \
        "pandas==2.2.3" \
        "pyarrow==18.1.0" \
        "scikit-learn==1.5.2" \
        "joblib==1.4.2" \
        "PyYAML==6.0.2" \
        "nibabel==5.3.2" \
        "nilearn==0.10.4" \
        "hmmlearn==0.3.3" \
        "umap-learn==0.5.7" \
        "numba==0.60.0" \
        "matplotlib==3.9.2" \
        "plotly==5.24.1" \
        "statsmodels==0.14.4" \
        "jupyterlab==4.3.4" \
        "ipywidgets==8.1.5" \
        "tqdm==4.67.1" \
        "pytest==8.3.4"

    # neuromaps for spin tests, nimare for Neurosynth decoding. Installed
    # after the pins so their resolver cannot silently move numpy.
    /opt/venv/bin/pip install --no-cache-dir \
        "neuromaps==0.0.5" \
        "nimare==0.4.0" \
        || echo "WARNING: neuromaps/nimare failed; figure 1 decoding will need them"

    # umap-learn pulls tensorflow-dependent ParametricUMAP at import if TF is
    # present. It is not installed here, so the import is quiet.

    # ---- R. Binaries from Posit PPM, which rocker configures.
    Rscript -e 'install.packages(c("brms","cmdstanr","posterior","bayesplot", \
                                   "loo","tidybayes","data.table","arrow"), \
                                 repos=c("https://stan-dev.r-universe.dev", \
                                         getOption("repos")))'
    # CmdStan itself, compiled once at build time so jobs never compile.
    Rscript -e 'cmdstanr::install_cmdstan(cores=4)'

%environment
    export PATH=/opt/venv/bin:$PATH
    export PYTHONNOUSERSITE=1
    export CMDSTAN=/root/.cmdstan/cmdstan-*
    # Threads are set by the SLURM script; a default of 1 stops BLAS and numba
    # each spawning a pool inside a 4-core task.
    export OMP_NUM_THREADS=${OMP_NUM_THREADS:-1}
    export MKL_NUM_THREADS=${MKL_NUM_THREADS:-1}
    export OPENBLAS_NUM_THREADS=${OPENBLAS_NUM_THREADS:-1}
    export NUMBA_NUM_THREADS=${NUMBA_NUM_THREADS:-1}

%test
    set -eu
    /opt/venv/bin/python3 -c "
import importlib
mods = ['numpy','scipy','pandas','pyarrow','sklearn','joblib','yaml','nibabel',
        'nilearn','hmmlearn','umap','matplotlib','plotly','statsmodels',
        'jupyterlab','tqdm','pytest']
missing = [m for m in mods if not importlib.util.find_spec(m)]
print('python MISSING:', missing) if missing else print('python ok')
import numpy, sklearn, hmmlearn
print('numpy', numpy.__version__, '| sklearn', sklearn.__version__)
"
    Rscript -e 'ok <- all(sapply(c("brms","cmdstanr","posterior","arrow"), requireNamespace, quietly=TRUE)); cat(if (ok) "R ok\n" else "R MISSING\n")'

%runscript
    exec /opt/venv/bin/python3 "$@"
