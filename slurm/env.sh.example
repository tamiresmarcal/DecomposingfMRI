# Per-user, per-cluster settings for the SLURM scripts. NOT project config.
#
#     cp slurm/env.sh.example slurm/env.sh
#     $EDITOR slurm/env.sh
#
# slurm/env.sh is gitignored, because every line in it is a fact about YOUR
# account on YOUR cluster. Commit nothing here; the .example is the shared
# part, your copy is the private part.
#
# All four scripts in slurm/ source it if it exists, so submitting by hand --
#     sbatch --array=0-19 slurm/extract_activations.sbatch config/ds002837.yaml
# -- behaves the same as ./slurm/activation_and_dfc.sh. Run sbatch from the repo root;
# that is how the scripts find this file.
#
# Every assignment uses `:=`, so anything already exported in your shell wins.
# A one-off override stays a one-off:
#     FMRIDECOMP_SIF=/other/image.sif ./slurm/activation_and_dfc.sh config/x.yaml

# ----------------------------------------------------------- interpreter ---
# Set ONE of these. Nothing in slurm/ will submit a job without it: the login
# node's bare `python` cannot import fmri_decomposition, and neither can a
# compute node's.
#
# The container is the tested path on Alliance clusters. The venv path exists
# for parity with the legacy pipeline and uses the cluster's own Python, whose
# prebuilt wheels are faster to install.
: "${FMRIDECOMP_SIF:=/project/6008063/tamires/singularity/fmri_decomp.sif}"
#: "${FMRIDECOMP_VENV:=$HOME/venvs/fmridecomp}"

# TWO IMAGES, ONE BOUNDARY (containers/README.md). Stages 2-3 run in
# fmri_decomp.sif above; stages 4-5 need fmri_decomp_stage45.sif, which is where
# Stan, hmmlearn, umap-learn and lightgbm live. The stage 4-5 scripts prefer this
# variable and fall back to FMRIDECOMP_SIF, so setting both means never editing
# this file between stages -- and never watching a cluster job die on
# `ModuleNotFoundError: hmmlearn` ten minutes in.
#
# Build it on a login node if it does not exist; see containers/README.md.
: "${FMRIDECOMP_SIF45:=/project/6008063/tamires/singularity/fmri_decomp_stage45.sif}"

# A container sees ONLY what is bound into it -- without the right binds a
# compute node reports "no such file" for data that plainly exists. Add any
# filesystem your config points at that is not already covered.
#: "${FMRIDECOMP_BINDS:=/project,/scratch,/home}"

# --------------------------------------------------------- SLURM account ---
# Read only by activation_and_dfc.sh, which passes it as `--account` -- the command
# line beats the `#SBATCH --account=` line in each script, which a hand-run
# sbatch would otherwise use. If you submit by hand, edit that line instead.
: "${FMRIDECOMP_ACCOUNT:=rpp-aevans-ab}"

# --------------------------------------------------------------- caches ---
# Compute nodes have no outbound network. A cache that is missing does not
# fail fast -- it hangs on an HTTP timeout and dies hours in. Pre-fetch on a
# login node; the scripts warn if the directory is absent.
#
# Leave NILEARN_DATA unset to let the scripts look in $HOME, $SCRATCH and $PWD
# in that order.
#: "${NILEARN_DATA:=$SCRATCH/nilearn_data}"

# Stage 1 (preprocessing/) only -- fMRIPrep, not this pipeline. FS_LICENSE
# points at a file holding your own FreeSurfer key, so keep it OUTSIDE the
# working tree: this repo is on GitHub.
#: "${TEMPLATEFLOW_HOME:=$HOME/templateflow}"
#: "${FS_LICENSE:=$HOME/freesurfer_license.txt}"

# ------------------------------------------------- interactive shortcuts ---
# NOT read by anything in slurm/ -- the sbatch scripts build their own command
# line. These are for YOUR shell, and they are here because every interactive
# command in the RUNBOOK begins `$RUN python3 ...`.
#
# An unset RUN does not fail: it runs the LOGIN NODE's bare python3, which has
# no numpy, so you get
#     ModuleNotFoundError: No module named 'numpy'
# from a command that looks right. Defining them here means sourcing this file
# is enough, which is what everyone assumes it already does.
if [[ -n "${FMRIDECOMP_SIF45:-}" ]]; then
  RUN="apptainer exec --cleanenv --bind ${FMRIDECOMP_BINDS:-/project,/scratch,/home} $FMRIDECOMP_SIF45"
fi
if [[ -n "${FMRIDECOMP_SIF:-}" ]]; then
  RUN23="apptainer exec --cleanenv --bind ${FMRIDECOMP_BINDS:-/project,/scratch,/home} --pwd $PWD $FMRIDECOMP_SIF"
fi

# ------------------------------------------------------ phenotype tables ---
# What the two selection stages take as `--pheno`. Uncomment and point at your
# own copy. Paths are a fact about YOUR filesystem, which is exactly why they
# belong in this file and why nothing in the repo can default them.
#
# An ARRAY, for two reasons: the entries are two separate arguments, and the
# first separator is a real tab, which $'\t' produces and "...\t..." does not.
#
# `--pheno` is required=True in both selections, so an empty PHENO is an
# argparse error -- exit code 2, raised when the JOB starts, which behind a
# dependency chain can be a day after you submitted it.
#: "${CAMCAN:=/project/<your_group>/<you>/cohorts/camcan/dataman/useraccess/opendata/<your_project>}"
#PHENO=("$CAMCAN/approved_data.tsv:"$'\t' "$CAMCAN/standard_data.csv:,")
#
# Not in the export list below: a bash array does not survive `export`. It does
# not need to -- `--pheno "${PHENO[@]}"` is expanded by this shell before sbatch
# ever runs, and the `--` forwarding keeps each element whole.

# -------------------------------------------------------------------------
# Export whatever ended up set, and only that -- exporting an unset name would
# hand the jobs an empty value that reads as "configured to nothing".
for _v in FMRIDECOMP_SIF FMRIDECOMP_SIF45 FMRIDECOMP_VENV FMRIDECOMP_BINDS \
          FMRIDECOMP_ACCOUNT \
          NILEARN_DATA TEMPLATEFLOW_HOME FS_LICENSE; do
  [[ -n "${!_v:-}" ]] && export "$_v"
done
unset _v
